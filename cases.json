{
  "cases": [
    {
      "id": "west-retail",
      "datasets": ["samples/orders.csv", "samples/products.csv"],
      "chat_questions": [
        {"question": "Only stores in the West region", "expected": {"status": "ok", "row_count_considered": 4}},
        {"question": "Among those, which categories had the highest return rate?", "expected": {"status": "ok", "preview": [{"category": "Apparel", "return_rate": 0.6}], "operation": "return_rate", "row_count_considered": 4}},
        {"question": "Among those, which status has the most records?", "expected": {"status": "ok", "preview": [{"status": "Completed", "count": 3}], "operation": "count", "row_count_considered": 4}},
        {"question": "What was the weather on our best sales day?", "expected": {"status": "refuse"}},
        {"question": "Which store is best?", "expected": {"status": "clarify"}}
      ]
    },
    {
      "id": "query-operations",
      "datasets": ["samples/orders.csv", "samples/products.csv"],
      "chat_questions": [
        {"question": "List distinct region", "expected": {"status": "ok", "preview": [{"region": "East"}, {"region": "West"}]}},
        {"question": "List units where units >= 3 sort by units desc limit 2", "expected": {"status": "ok", "preview": [{"units": 10}, {"units": 6}], "row_count_considered": 4}},
        {"question": "Compare total revenue in East and West", "expected": {"status": "ok", "preview": [{"region": "East", "gross_sales": "1000.0000"}, {"region": "West", "gross_sales": "1000.0000"}]}},
        {"question": "Bottom 1 category by gross sales", "expected": {"status": "ok", "preview": [{"category": "Home", "gross_sales": "500.0000"}]}},
        {"question": "Median units", "expected": {"status": "ok", "preview": [{"median": 4.0}], "operation": "median"}},
        {"question": "Show raw revenue by category", "expected": {"status": "refuse"}},
        {"question": "Use an unauthorized field", "plan": {"intent": "select", "dataset": "d1", "fields": ["secret_field"]}, "expected": {"status": "rejected", "error_code": "unknown_field"}}
      ]
    },
    {"id": "isolated-malformed-file", "datasets": ["samples/malformed.csv"]},
    {
      "id": "duplicate-key",
      "datasets": ["samples/orders.csv", {"path": "samples/products_duplicate.csv", "role": "products"}],
      "chat_questions": [
        {"question": "Show total revenue by category", "expected": {"status": "rejected", "error_code": "unsafe_join"}}
      ]
    }
  ]
}
